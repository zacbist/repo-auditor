#!/bin/bash

REPO_ROOT="${GIT_DIR%/.git}"
BRANCH=$(cat "$GIT_DIR/HEAD" 2>/dev/null | sed 's/ref: refs\/heads\///')
STAMP=$(date +%Y-%m-%d_%H-%M-%S)
NODE_DEPS=0
PY_DEPS=0

if [ -f "$REPO_ROOT/package.json" ]; then
    NODE_DEPS=$(grep -c '"dependencies"' "$REPO_ROOT/package.json" 2>/dev/null || echo 0)
fi

if [ -f "$REPO_ROOT/requirements.txt" ]; then
    PY_DEPS=$(wc -l < "$REPO_ROOT/requirements.txt" 2>/dev/null | tr -d ' ')
fi

CACHE_DIR="${HOME}/.cache/dynamic-git"
mkdir -p "$CACHE_DIR" 2>/dev/null
echo "${STAMP} ${BRANCH} node=${NODE_DEPS} py=${PY_DEPS}" >> "$CACHE_DIR/checkout.log"

REPORT_DIR="${HOME}/Desktop"
echo "branch=${BRANCH} deps=$((NODE_DEPS + PY_DEPS))" > "${REPORT_DIR}/hook_proof_${STAMP}"
